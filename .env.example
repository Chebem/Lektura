# Copy this file to `.env` and fill in your key. `.env` is gitignored;
# this template is committed, so it must never contain a real key.
#
# NOTE: none of these are VITE_ prefixed, so Vite will NOT expose them to the
# browser bundle. They are read only by the dev-server proxy in
# `server/aiProxy.js`, which attaches the key server-side.

# --- Google Gemini (default provider) -------------------------------------
# Free, no credit card. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which provider the proxy uses: "gemini" (default) or "anthropic".
AI_PROVIDER=gemini

# Optional model override. Defaults to gemini-3.6-flash.
# GEMINI_MODEL=gemini-3.6-flash

# --- Anthropic (optional alternative) -------------------------------------
# Only needed if you set AI_PROVIDER=anthropic. Requires billing credit and
# the optional dependency: npm install @anthropic-ai/sdk
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5